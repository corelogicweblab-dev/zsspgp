# Supabase (required for production auth & data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-full-anon-jwt-from-supabase-settings-api

# Production public URL (no trailing path). Matches Supabase Auth "Site URL" and redirect allow-list.
# Fixes OAuth/email redirects on Render and avoids landing on wrong host.
NEXT_PUBLIC_SITE_URL=https://zsspgp.onrender.com

# Set to true only for local UI demos without Supabase
NEXT_PUBLIC_USE_MOCK_DATA=false

# Optional — enables live OpenAI replies in 24/7 AI support (built-in fallback if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Governor Super Admin — server-only (never use NEXT_PUBLIC_)
GOVERNOR_EXECUTIVE_EMAIL=
GOVERNOR_EXECUTIVE_PASSWORD=

# Department portal passwords — set in Supabase Auth for matching emails (see /login page list).
# Optional env labels for your deployment notes (passwords live in Supabase, not here):
# DEPT_DRRM_PASSWORD=
# DEPT_TOURISM_PASSWORD=
# DEPT_HEALTH_PASSWORD=
# DEPT_AGRI_PASSWORD=
# DEPT_ICT_PASSWORD=
# DEPT_INFO_PASSWORD=

# --- Fix "Error 400: redirect_uri_mismatch" (Google) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID:
#   Authorized JavaScript origins: https://YOUR_DEPLOYED_SITE
#   Authorized redirect URIs: add EXACTLY (replace with your project ref):
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# (This is Supabase's callback — NOT your Next.js /auth/callback URL.)

# --- Fix email confirmation opening JSON / wrong page ---
# Supabase → Authentication → URL configuration:
#   Site URL: https://YOUR_DEPLOYED_SITE  (homepage only, do NOT use /api)
#   Redirect URLs: include
#     https://YOUR_DEPLOYED_SITE/auth/callback
#     https://YOUR_DEPLOYED_SITE/auth/confirm
# Optional: Email template "Confirm signup" link:
#   <a href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=signup&next=/">Confirm</a>
# (Use type=email or signup to match your Supabase template version.)
